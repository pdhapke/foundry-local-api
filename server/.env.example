# Copy this file to `.env` (gitignored) and adjust as needed.
# All variables are optional; documented defaults apply when unset.

# TCP port the HTTP server listens on.
# Default: 3939
PORT=3939

# Address the HTTP server binds to. The GM bridge lane requires an explicit
# loopback address (127.0.0.1, localhost, or ::1). API-key auth applies only
# to /api/* and /mcp; it does not make the GM bridge safe on a remote bind.
# Default: 127.0.0.1
HOST=127.0.0.1

# Historical REST/MCP-only escape hatch. Setting this to true may expose those
# administrative transports on a non-loopback HOST, but BridgeGateway refuses
# to start there. Keep false when the browser bridge is enabled.
# Default: (unset / false)
ALLOW_REMOTE_BIND=false

# Standard Node environment. Controls whether error responses include
# extra detail / stack traces get logged verbosely.
# One of: development | production | test
# Default: development
NODE_ENV=development

# Milliseconds to wait for in-flight requests to finish during graceful
# shutdown (SIGINT/SIGTERM) before forcing process exit.
# Default: 10000
SHUTDOWN_TIMEOUT_MS=10000

# Default milliseconds FoundryClient.call() waits for a response over the
# /bridge WebSocket before rejecting with a TIMEOUT error. Individual calls
# may override this per-call; this is just the default. Must be a positive
# integer.
# Default: 10000
BRIDGE_TIMEOUT_MS=10000

# Static administrative API key required on every /api/* request (via the
# X-Api-Key header) and every /mcp request. It is never sent to a Foundry
# browser and cannot authenticate /bridge; the GM bridge lane independently
# validates the browser's existing Foundry session with the local Foundry
# server.
#
# Auto-provisioned: if this is left unset/empty, the server generates a
# random key on first startup and writes it back into this .env file for
# you (logging a one-time message so you know where to find it) — no
# manual setup needed. Restarting the server afterward reuses the saved
# key rather than generating a new one.
#
# If you'd rather set your own (e.g. to deliberately share one key across
# multiple .env files), you can still do that — just paste a value here.
# An explicit value shorter than 16 characters is rejected and the server
# refuses to start (fail closed), since that's assumed to be a deliberate
# but too-weak choice rather than nothing having been set.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Default: auto-generated on first startup if left unset.
API_KEY=

# Comma-separated list of origins allowed to make cross-origin browser
# requests to /api/*. Deny-by-default: leave unset/empty to reject all
# cross-origin requests (same-origin and non-browser clients like curl are
# unaffected either way, since they don't send an Origin header CORS acts
# on).
# Example: CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:5173
# Default: (unset / empty = deny all cross-origin)
CORS_ALLOWED_ORIGINS=

# Rate-limit window (milliseconds) applied to /api/* (not /health). Must be
# a positive integer.
# Default: 60000
RATE_LIMIT_WINDOW_MS=60000

# Max requests allowed per RATE_LIMIT_WINDOW_MS per client, applied to
# /api/* (not /health). Must be a positive integer.
# Default: 100
RATE_LIMIT_MAX=100

# Set to "true" to also start an MCP server on this process's own stdio
# (Phase 5), for MCP clients (Claude Desktop, Claude Code) that spawn this
# process directly instead of talking HTTP. Not something you normally set
# in this file by hand — it's meant to be set by the MCP client's own server
# config, e.g. a Claude Desktop/Code `mcpServers` entry:
#   { "command": "node", "args": ["dist/index.js"], "env": { "MCP_STDIO": "true" } }
#
# While this is "true", stdout is reserved exclusively for the MCP
# JSON-RPC stream — the startup banner and request log move to stderr
# instead so nothing else corrupts it. Leave unset for normal HTTP-only use.
# Default: (unset / false)
MCP_STDIO=false

# --- Remote MCP (optional) ----------------------------------------------
# Set this to open a second loopback listener that serves ONLY /mcp. Point
# ngrok or cloudflared at that port, not at PORT. The main listener keeps
# /api, /health, and /bridge for direct local use. This process does not
# start a tunnel; tunnel install/UI lives with AI Dungeon Master.
#
# The value must be different from API_KEY and at least 16 characters. It is
# accepted on /mcp (Bearer or X-Api-Key) and rejected everywhere else, so the
# administrative key never has to leave this machine. Unset disables the
# public listener entirely.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Default: (unset / public listener off)
MCP_REMOTE_API_KEY=

# Port for the public /mcp listener. Ignored until MCP_REMOTE_API_KEY is set.
# Always bound to 127.0.0.1, never HOST. Must differ from PORT.
# Default: 3940
MCP_PUBLIC_PORT=3940

# Hostnames allowed to call the public /mcp listener (DNS-rebinding
# protection). Comma-separated hostnames, IPs, or a single-label wildcard
# such as *.trycloudflare.com. When this is set, OR when remote MCP is
# enabled, the main listener also rejects any Host that is not loopback or
# *.localhost. Leave unset to skip the Host check.
# Example: MCP_ALLOWED_HOSTS=foundry-mcp.example.com,*.trycloudflare.com
# Default: (unset / no Host check)
MCP_ALLOWED_HOSTS=

# Rate limit for the public /mcp listener only. It does not use Express
# trust proxy: the client bucket is the rightmost X-Forwarded-For address
# (or CF-Connecting-IP when that header is the only signal, or one shared
# bucket when a raw TCP tunnel adds neither). /api keeps RATE_LIMIT_*.
# Defaults: 60000 ms window, 120 requests.
MCP_REMOTE_RATE_LIMIT_WINDOW_MS=60000
MCP_REMOTE_RATE_LIMIT_MAX=120

# Optional cap on concurrent Streamable HTTP sessions, per listener (local
# /mcp and the public listener each have their own map). Unset disables the
# cap. A held SSE connection counts as one session.
# MCP_MAX_SESSIONS=32

# Optional idle expiry in milliseconds. A session with no in-flight request
# (a held SSE GET counts as in flight) is closed after this long. Unset
# disables expiry.
# MCP_SESSION_IDLE_MS=1800000
