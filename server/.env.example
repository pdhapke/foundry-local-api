# Copy this file to `.env` (gitignored) and adjust as needed.
# All variables are optional; documented defaults apply when unset.

# TCP port the HTTP server listens on.
# Default: 3939
PORT=3939

# Address the HTTP server binds to. Must be a loopback address
# (127.0.0.1, localhost, ::1) unless ALLOW_REMOTE_BIND=true is also set.
# API-key auth (see API_KEY below) applies to /api/* and /bridge either
# way, but remote binding is still refused by default as a second layer
# of defense.
# Default: 127.0.0.1
HOST=127.0.0.1

# Set to "true" to allow HOST to be a non-loopback address (e.g. 0.0.0.0
# or a LAN IP). Logs a loud warning on startup when used. API-key auth
# still applies, but only do this on a trusted network.
# Default: (unset / false)
ALLOW_REMOTE_BIND=false

# Standard Node environment. Controls whether error responses include
# extra detail / stack traces get logged verbosely.
# One of: development | production | test
# Default: development
NODE_ENV=development

# Milliseconds to wait for in-flight requests to finish during graceful
# shutdown (SIGINT/SIGTERM) before forcing process exit.
# Default: 10000
SHUTDOWN_TIMEOUT_MS=10000

# Default milliseconds FoundryClient.call() waits for a response over the
# /bridge WebSocket before rejecting with a TIMEOUT error. Individual calls
# may override this per-call; this is just the default. Must be a positive
# integer.
# Default: 10000
BRIDGE_TIMEOUT_MS=10000

# Static API key required on every /api/* request (via the X-Api-Key
# header) and every /bridge WebSocket connection (via a ?apiKey=... query
# param, since a browser WebSocket can't set custom handshake headers).
#
# Auto-provisioned: if this is left unset/empty, the server generates a
# random key on first startup and writes it back into this .env file for
# you (logging a one-time message so you know where to find it) — no
# manual setup needed. Restarting the server afterward reuses the saved
# key rather than generating a new one.
#
# If you'd rather set your own (e.g. to deliberately share one key across
# multiple .env files), you can still do that — just paste a value here.
# An explicit value shorter than 16 characters is rejected and the server
# refuses to start (fail closed), since that's assumed to be a deliberate
# but too-weak choice rather than nothing having been set.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Default: auto-generated on first startup if left unset.
API_KEY=

# Comma-separated list of origins allowed to make cross-origin browser
# requests to /api/*. Deny-by-default: leave unset/empty to reject all
# cross-origin requests (same-origin and non-browser clients like curl are
# unaffected either way, since they don't send an Origin header CORS acts
# on).
# Example: CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:5173
# Default: (unset / empty = deny all cross-origin)
CORS_ALLOWED_ORIGINS=

# Rate-limit window (milliseconds) applied to /api/* (not /health). Must be
# a positive integer.
# Default: 60000
RATE_LIMIT_WINDOW_MS=60000

# Max requests allowed per RATE_LIMIT_WINDOW_MS per client, applied to
# /api/* (not /health). Must be a positive integer.
# Default: 100
RATE_LIMIT_MAX=100
